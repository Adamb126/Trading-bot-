# Kraken API credentials (create at https://www.kraken.com/u/security/api)
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Trade sizing (EUR per trade)
TRADE_AMOUNT_EUR=100

# Daily risk limits (as decimals: 0.10 = 10%)
DAILY_PROFIT_TARGET=0.10
DAILY_STOP_LOSS=0.075

# Set to "false" to enable live trading
DRY_RUN=true
