# Kraken API credentials
# Get these from: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Trading configuration (overrides defaults in config.py)
TRADE_AMOUNT_EUR=100       # EUR amount per trade
DAILY_PROFIT_TARGET=0.10   # 10% daily profit target
DAILY_STOP_LOSS=0.075      # 7.5% daily stop loss
DRY_RUN=true               # Set to false for live trading
